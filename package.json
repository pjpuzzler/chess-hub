{
  "private": true,
  "name": "chess-hub",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "test": "vitest run",
    "build:puzzles": "node --experimental-strip-types tools/build-puzzles.ts",
    "mock": "vite --mode mock",
    "build:elo": "node --experimental-strip-types tools/build-elo-games.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.1",
    "@devvit/web": "0.15.1",
    "@hono/node-server": "2.1.3",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "devvit": "0.15.1",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@devvit/test": "^0.15.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "happy-dom": "^15.11.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "^5.0.5"
  }
}
